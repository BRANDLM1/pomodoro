<h1>Pomodoro Timer</h1>
<p> Find me in app/views/timers/home.html.erb </p>

<div class = "theme-settings"
    <h2> Choose Your Theme! </h2>

    <form action = "/timers/start" method = "get">
        <div class = "color-selector">
            <h3> Pick a color </h3>
            <input type="radio" id="color_red" name="color" value="red" checked>
            <label for="color_red" class="color-label red">Red</label>

            <input type="radio" id="color_blue" name="color" value="blue" >
            <label for="color_blue" class="color-label blue">Blue</label>

            <input type="radio" id="color_green" name="color" value="green" >
            <label for="color_green" class="color-label green">Green</label>

            <input type="radio" id="color_yellow" name="color" value="yellow" >
            <label for="color_yellow" class="color-label yellow">Yellow</label>

            <input type="radio" id="color_orange" name="color" value="orange" >
            <label for="color_orange" class="color-label orange">Orange</label>

            <input type="radio" id="color_purple" name="color" value="purple" >
            <label for="color_purple" class="color-label purple">Purple</label>
        </div>

        <div class = "timer-settings">

            <h3> Timer Settings </h3>
            <div class = "setting">
                <label for "session_time">Session Time:</label>
                <input type = "number" id = "session_time" name = "session_time" value = "25" min = "1" max = "60">
            </div>

            <div class = "setting">
                <label for "break_time">Break Time:</label>
                <input type = "number" id = "break_time" name = "break_time" value = "5" min = "1" max = "12">
            </div>
        </div>

        <button type="submit" class="start-button">Start Timer</button>
    </form>
</div>